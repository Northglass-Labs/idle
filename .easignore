docs
docs/
notes
notes/

# Native projects are generated remotely. Local native builds and the
# standalone cryptography harness are never part of the production app.
packages/idle-app/ios
packages/idle-app/ios/
packages/idle-app/android
packages/idle-app/android/
packages/idle-app/native-tests
packages/idle-app/native-tests/
packages/idle-app/.eas/workflows
packages/idle-app/.eas/workflows/

# Native CLI payloads are not source inputs. File discovery uses a system
# ripgrep installation or the bounded JavaScript fallback.
packages/idle-cli/tools
packages/idle-cli/tools/
packages/idle-cli/package
packages/idle-cli/package/
