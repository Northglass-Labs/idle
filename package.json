{
  "name": "idle",
    "private": true,
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "cli": "yarn workspace idle-coder cli",
        "web": "yarn workspace idle-app web",
        "postinstall": "node ./scripts/postinstall.cjs",
        "env:new": "tsx environments/environments.ts new",
        "env:list": "tsx environments/environments.ts list",
        "env:use": "tsx environments/environments.ts use",
        "env:remove": "tsx environments/environments.ts remove",
        "env:current": "tsx environments/environments.ts current",
        "env:server": "tsx environments/environments.ts run server",
        "env:web": "tsx environments/environments.ts run web",
        "env:ios": "tsx environments/environments.ts run ios",
        "env:android": "tsx environments/environments.ts run android",
        "env:cli": "tsx environments/environments.ts run cli",
        "env:seed": "tsx environments/environments.ts seed",
        "env:up": "tsx environments/environments.ts up",
        "env:up:authenticated": "yarn env:up --template authenticated-empty",
        "env:down": "tsx environments/environments.ts down",
        "env:tailscale": "tsx environments/environments.ts tailscale",
        "typecheck": "yarn workspace @northglass/idle-wire build && yarn workspace idle-coder typecheck && yarn workspace @northglass/agent typecheck && yarn workspace idle-app typecheck && yarn workspace @northglass/idle-server build && yarn workspace idle-e2e typecheck",
        "test": "yarn workspace @northglass/idle-wire test && yarn workspace idle-coder test:unit && yarn workspace @northglass/idle-server test && yarn workspace @northglass/agent test && yarn workspace idle-app test --run && yarn workspace idle-app test:export-boundary",
        "test:e2e": "yarn workspace idle-e2e test",
        "verify:upstream-import": "node scripts/verify-upstream-import.mjs"
    },
    "workspaces": {
        "packages": [
            "packages/idle-app",
            "packages/idle-agent",
            "packages/idle-cli",
            "packages/idle-e2e",
            "packages/idle-e2e-mobile",
            "packages/idle-server",
            "packages/idle-wire"
        ],
        "nohoist": [
            "**/zod",
            "**/react",
            "**/react-dom",
            "**/react-native",
            "**/react-native/**",
            "**/react-native-edge-to-edge/**",
            "**/react-native-incall-manager/**"
        ]
    },
    "packageManager": "yarn@1.22.22",
    "resolutions": {
        "@babel/core": "^7.29.6",
        "@hono/node-server": "^2.0.5",
        "@isaacs/brace-expansion": "^5.0.1",
        "@xmldom/xmldom": "^0.8.13",
        "axios": "^1.18.1",
        "body-parser": "^2.3.0",
        "defu": "^6.1.5",
        "dompurify": "^3.4.12",
        "engine.io": "^6.6.9",
        "fast-uri": "^3.1.7",
        "fast-xml-parser": "^5.10.1",
        "flatted": "3.4.2",
        "follow-redirects": "^1.16.0",
        "lodash-es": "^4.18.1",
        "path-to-regexp": "^8.4.2",
        "postcss": "^8.5.16",
        "qs": "^6.15.3",
        "rollup": "^4.62.2",
        "whatwg-url": "14.2.0",
        "parse-path": "7.0.3",
        "@types/parse-path": "7.0.3",
    "@expo/dom-webview": "55.0.6",
    "expo-modules-core": "55.0.25",
    "expo-updates-interface": "55.1.6",
        "shell-quote": "^1.8.4",
        "fastify": "^5.8.5",
        "tar": "^7.5.8",
        "socket.io-parser": "^4.2.6",
        "node-forge": "^1.4.0",
        "lodash": "^4.18.0",
        "tmp": "^0.2.6",
        "**/@eslint/eslintrc/ajv": "6.14.0",
        "**/eslint/ajv": "6.14.0",
        "**/xcode/uuid": "11.1.1",
        "form-data": "^4.0.6",
        "ws": "^8.21.0"
    }
}
