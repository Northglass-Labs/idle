        "APP_ENV": "development",
        "SHARP_IGNORE_GLOBAL_LIBVIPS": "1"
      }
    },
    "development-simulator": {
      "autoIncrement": true,
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
