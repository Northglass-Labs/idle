        "simulator": true
      },
      "env": {
        "APP_ENV": "preview",
        "SHARP_IGNORE_GLOBAL_LIBVIPS": "1"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "node": "22.17.0",
      "env": {
        "APP_ENV": "production",
        "SHARP_IGNORE_GLOBAL_LIBVIPS": "1"
