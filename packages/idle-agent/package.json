{
  "name": "@northglass/agent",
  "version": "0.4.3",
  "description": "Headless CLI for remotely managing Idle coding-agent sessions",
  "author": "Northglass",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/Northglass-Labs/idle/tree/main/packages/idle-agent",
  "bugs": "https://github.com/Northglass-Labs/idle/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Northglass-Labs/idle.git"
  },
  "bin": {
    "idle-agent": "bin/idle-agent.mjs"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "bin/idle-agent.mjs"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc --noEmit && pkgroll",
    "test": "$npm_execpath run build && vitest run",
    "test:integration": "$npm_execpath run build && vitest run --config vitest.integration.config.ts",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "$npm_execpath run build && $npm_execpath test"
  },
  "dependencies": {
    "@northglass/idle-wire": "0.4.3",
    "axios": "^1.15.3",
    "chalk": "^5.6.2",
    "commander": "^13.1.0",
    "qrcode-terminal": "^0.12.0",
    "socket.io-client": "^4.8.1",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": ">=20",
    "@types/qrcode-terminal": "^0.12.2",
    "pkgroll": "^2.14.2",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vitest": "^3.2.6"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "packageManager": "yarn@1.22.22"
}
