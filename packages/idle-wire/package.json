{
  "name": "@northglass/idle-wire",
  "version": "0.4.3",
  "description": "Shared message wire types and Zod schemas for Idle clients and services",
  "author": "Northglass",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "homepage": "https://github.com/Northglass-Labs/idle/tree/main/packages/idle-wire",
  "bugs": "https://github.com/Northglass-Labs/idle/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Northglass-Labs/idle.git"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "files": [
    "LICENSE",
    "dist",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "shx rm -rf dist && tsc --noEmit && pkgroll",
    "test": "$npm_execpath run build && vitest run",
    "prepublishOnly": "$npm_execpath run build && $npm_execpath run test"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^2.2.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": ">=20",
    "pkgroll": "^2.14.2",
    "shx": "^0.3.3",
    "typescript": "5.9.3",
    "vitest": "^3.2.6"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "packageManager": "yarn@1.22.22"
}
