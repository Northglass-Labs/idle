{
  "name": "@northglass/idle-server",
  "version": "0.4.0",
  "description": "Self-hosted encrypted relay runtime for Idle",
  "repository": "https://github.com/Northglass-Labs/idle.git",
  "homepage": "https://idle.northglass.io",
  "bugs": "https://github.com/Northglass-Labs/idle/issues",
  "author": "Northglass",
  "license": "MIT",
  "private": false,
  "type": "module",
  "main": "./index.cjs",
  "exports": {
    ".": "./index.cjs"
  },
  "bin": {
    "idle-server": "bin/idle-server.cjs"
  },
  "files": [
    "LICENSE",
    "bin/idle-server.cjs",
    "dist/standalone.mjs",
    "index.cjs",
    "prisma/migrations",
    "prisma/schema.prisma",
    "README.md",
    "scripts/generate-prisma.cjs"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run typecheck && npm run build:runtime",
    "build:standalone": "npm run build:runtime",
    "start": "tsx ./sources/main.ts",
    "standalone": "tsx ./sources/standalone.ts",
    "standalone:dev": "tsx ./sources/standalone.ts migrate && tsx ./sources/standalone.ts serve",
    "dev": "npm run standalone:dev",
    "test": "vitest run && node --test scripts/package-contract.test.cjs scripts/pglite-account-admission-contract.test.cjs scripts/pglite-attachment-budget-contract.test.cjs scripts/pglite-bytes-contract.test.cjs scripts/pglite-canonical-attachment-identity-contract.test.cjs scripts/pglite-provider-vault-contract.test.cjs scripts/pglite-usage-contract.test.cjs scripts/pglite-voice-capacity-contract.test.cjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "migrate": "prisma migrate dev",
    "migrate:reset": "prisma migrate reset",
    "generate": "prisma generate --schema=prisma/schema.prisma",
    "postinstall": "node scripts/generate-prisma.cjs",
    "prepack": "npm run build:runtime && node --test scripts/package-contract.test.cjs scripts/pglite-account-admission-contract.test.cjs scripts/pglite-attachment-budget-contract.test.cjs scripts/pglite-bytes-contract.test.cjs scripts/pglite-canonical-attachment-identity-contract.test.cjs scripts/pglite-provider-vault-contract.test.cjs scripts/pglite-usage-contract.test.cjs scripts/pglite-voice-capacity-contract.test.cjs",
    "prepublishOnly": "npm run typecheck && npm test",
    "typecheck": "tsc --noEmit",
    "build:runtime": "node scripts/build-runtime.cjs",
    "bundle:webapp": "node ../idle-cli/scripts/bundle-webapp.cjs --out-dir webapp"
  },
  "devDependencies": {
    "@northglass/idle-wire": "0.4.3",
    "@types/chalk": "^2.2.0",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.12.3",
    "@types/tmp": "^0.2.6",
    "@types/uuid": "^9.0.8",
    "esbuild": "0.25.12",
    "prisma-json-types-generator": "^3.5.1",
    "tar": "^7.5.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.6",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "@date-fns/tz": "^1.2.0",
    "@electric-sql/pglite": "^0.3.15",
    "@fastify/bearer-auth": "^10.1.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^9.3.0",
    "@paralleldrive/cuid2": "^2.2.2",
    "@prisma/client": "6.19.3",
    "@socket.io/redis-streams-adapter": "^0.2.2",
    "axios": "^1.18.1",
    "chalk": "4.1.2",
    "date-fns": "^4.1.0",
    "elevenlabs": "^1.54.0",
    "fastify": "^5.12.1",
    "fastify-type-provider-zod": "^6.1.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.7",
    "pglite-prisma-adapter": "0.6.1",
    "pino": "^10.3.0",
    "pino-pretty": "^13.0.0",
    "prisma": "6.19.3",
    "privacy-kit": "^0.0.25",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.35.0",
    "socket.io": "^4.8.3",
    "socket.io-adapter": "^2.5.5",
    "tmp": "^0.2.3",
    "tweetnacl": "^1.0.3",
    "zod": "^4.0.0",
    "zod-to-json-schema": "^3.24.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
