{
  "name": "idle-e2e-mobile",
  "version": "0.0.1",
  "private": true,
  "description": "Maestro flows that drive the Idle iOS app on a simulator or real device. Companion to idle-e2e (web/playwright).",
  "scripts": {
    "test": "./scripts/run-authed.sh",
    "test:smoke": "maestro test flows/00-smoke.yaml -e APP_ID=${IDLE_APP_ID:-com.northglass.idle.preview}",
    "test:welcome": "maestro test flows/01-auth.yaml -e APP_ID=${IDLE_APP_ID:-com.northglass.idle.preview}",
    "test:session": "./scripts/run-authed.sh flows/02-open-session.yaml",
    "test:compose": "./scripts/run-authed.sh flows/03-compose-message.yaml",
    "test:long-press": "./scripts/run-authed.sh flows/04-long-press-menu.yaml",
    "test:effort": "./scripts/run-authed.sh flows/05-effort-picker.yaml",
    "test:think": "./scripts/run-authed.sh flows/06-think-autocomplete.yaml",
    "test:timestamps": "./scripts/run-authed.sh flows/07-timestamp-display.yaml",
    "test:context": "./scripts/run-authed.sh flows/08-context-indicator.yaml",
    "test:links": "./scripts/run-authed.sh flows/09-open-links-in-toggle.yaml",
    "test:ultrathink": "./scripts/run-authed.sh flows/10-ultrathink-strip.yaml",
    "test:connection": "./scripts/run-authed.sh flows/11-connection-status-sheet.yaml",
    "test:lab": "./scripts/run-authed.sh flows/13-lab-subscreen.yaml",
    "test:release": "./scripts/run-release.sh",
    "test:release:codex": "./scripts/run-authed.sh flows/14-live-codex-session.yaml",
    "test:release:claude": "./scripts/run-authed.sh flows/15-live-claude-session.yaml",
    "test:release:relaunch": "./scripts/run-authed.sh flows/16-live-session-relaunch.yaml",
    "test:fixes": "./scripts/run-authed.sh flows/04-long-press-menu.yaml && ./scripts/run-authed.sh flows/05-effort-picker.yaml && ./scripts/run-authed.sh flows/06-think-autocomplete.yaml && ./scripts/run-authed.sh flows/07-timestamp-display.yaml",
    "dev-client": "./scripts/dev-client-maestro.sh",
    "dev-client:smoke": "./scripts/dev-client-maestro.sh smoke",
    "dev-client:all-public": "./scripts/dev-client-maestro.sh all-public",
    "dev-client:metro-status": "./scripts/dev-client-maestro.sh metro-status",
    "dev-client:metro-restart": "./scripts/dev-client-maestro.sh metro-restart",
    "studio": "maestro studio",
    "doctor": "maestro list-devices"
  }
}
